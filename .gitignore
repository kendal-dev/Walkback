# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/.utmp/

# Never ignore asset meta files
!/[Aa]ssets/**/*.meta

# IDE and solution files generated by Unity
.vs/
.vscode/
.idea/
.gradle/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity crash and log output
sysinfo.txt
crashlytics-build.properties
*.log

# Builds: the APK goes to GitHub Releases, never into the repository
*.apk
*.aab
*.unitypackage

# Raw NASA downloads are linked in DATA.md, never committed
/data-pipeline/raw/
/data-pipeline/tmp/

# Model test build output
/model-tests/bin/
/model-tests/obj/

# Web tooling
node_modules/

# Local Claude Code settings
.claude/settings.local.json

# OS
.DS_Store
Thumbs.db
desktop.ini
