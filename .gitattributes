# Line endings
* text=auto

# Unity YAML: keep as text, LF
*.cs text diff=csharp
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf

# Git LFS: large binaries
*.r16 filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.glb filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text

# Git LFS: the big site photos
Assets/StreamingAssets/Site/*.jpg filter=lfs diff=lfs merge=lfs -text
Assets/StreamingAssets/Site/*.png filter=lfs diff=lfs merge=lfs -text

# GitHub Pages cannot serve LFS files: nothing under web/ goes through LFS
web/** -filter -diff -merge
